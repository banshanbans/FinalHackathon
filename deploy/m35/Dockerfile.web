FROM node:22-alpine AS build

WORKDIR /app
COPY apps/presentation/package.json apps/presentation/package-lock.json ./
RUN npm ci
COPY apps/presentation ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/m35/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
