FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app:/app/apps/api/src

WORKDIR /app

COPY pyproject.toml README.md ./
COPY simulation ./simulation
COPY apps/api ./apps/api
COPY data ./data
COPY runtime/m34/exp_m34_35ca2026081a ./runtime/m34/exp_m34_35ca2026081a

RUN pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /app/runtime
USER appuser

EXPOSE 8000

CMD ["uvicorn", "policyscope_api.main:app", "--app-dir", "apps/api/src", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
