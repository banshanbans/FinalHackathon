{
  "name": "policyscope-roadshow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/assert-boundaries.mjs",
    "build": "npm run typecheck && npm run check:boundaries && vite build && node scripts/assert-boundaries.mjs dist/client && node scripts/prepare-sites-build.mjs",
    "verify": "npm test && npm run build && npm run test:sites",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check:isolated": "node scripts/check-isolated-build.mjs",
    "package:offline": "npm run build && node scripts/package-offline.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.5",
    "d3-geo": "3.1.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "postprocessing": "6.38.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.182.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/d3-geo": "3.1.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "25.0.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "6.4.2",
    "vitest": "4.1.10"
  }
}
